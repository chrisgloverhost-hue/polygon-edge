modules = ["go-1.21", "bash", "nodejs-20"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Fem Chain Devnet"

[[workflows.workflow]]
name = "Fem Chain Devnet"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash start-fem-chain.sh"
waitForPort = 8080

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 8080
externalPort = 80
